      "source": [
        "from rdkit import Chem\n",
        "from rdkit.Chem.rdFingerprintGenerator import AdditionalOutput\n",
        "\n",
        "def get_bit_atom_bond_indices(mol, bit_id):\n",
        "    \"\"\"\n",
        "    Returns atom and bond indices contributing to a given ECFP (Morgan) bit.\n",
        "    Uses the SAME MorganGenerator as fingerprinting.\n",
        "    \"\"\"\n",
        "    ao = AdditionalOutput()\n",
        "    ao.AllocateBitInfoMap()\n",
        "\n",
        "    fp = fpgen.GetFingerprint(mol, additionalOutput=ao)\n",
        "\n",
        "    bit_info = ao.GetBitInfoMap()\n",
        "\n",
        "    if bit_id not in bit_info:\n",
        "        return [], []\n",
        "\n",
        "    atom_indices = set()\n",
        "    bond_indices = set()\n",
        "\n",
        "    for atom_idx, radius_val in bit_info[bit_id]:\n",
        "        env = Chem.FindAtomEnvironmentOfRadiusN(\n",
        "            mol, radius_val, atom_idx\n",
        "        )\n",
        "\n",
        "        for bond_idx in env:\n",
        "            bond_indices.add(bond_idx)\n",
        "            bond = mol.GetBondWithIdx(bond_idx)\n",
        "            atom_indices.add(bond.GetBeginAtomIdx())\n",
        "            atom_indices.add(bond.GetEndAtomIdx())\n",
        "\n",
        "        # central atom must be included\n",
        "        atom_indices.add(atom_idx)\n",
        "\n",
        "    return sorted(atom_indices), sorted(bond_indices)\n"
      ],
