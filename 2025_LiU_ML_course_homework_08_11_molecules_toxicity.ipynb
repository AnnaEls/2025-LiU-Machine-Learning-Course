      "source": [
        "from rdkit.Chem import Draw\n",
        "\n",
        "def draw_bit_overlay(smiles, bit_id, size=(400, 300)):\n",
        "    mol = Chem.MolFromSmiles(smiles)\n",
        "    if mol is None:\n",
        "        raise ValueError(\"Invalid SMILES\")\n",
        "\n",
        "    atoms, bonds = get_bit_atom_bond_indices(mol, bit_id)\n",
        "\n",
        "    if not atoms:\n",
        "        print(f\"Bit {bit_id} not present in molecule.\")\n",
        "        return None\n",
        "\n",
        "    return Draw.MolToImage(\n",
        "        mol,\n",
        "        size=size,\n",
        "        highlightAtoms=atoms,\n",
        "        highlightBonds=bonds,\n",
        "        highlightAtomColors={i: (1.0, 0.2, 0.2) for i in atoms},\n",
        "        highlightBondColors={i: (1.0, 0.2, 0.2) for i in bonds},\n",
        "    )\n"
      ],
