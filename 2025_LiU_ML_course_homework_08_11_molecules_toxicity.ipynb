        "# Best result - confusion matrix"
      ],
      "metadata": {
        "id": "dMHMu_VA19Db"
      }
    },
    {
      "cell_type": "code",
      "source": [
        "from sklearn.metrics import confusion_matrix\n",
        "import seaborn as sns\n",
        "import matplotlib.pyplot as plt\n",
        "\n",
        "alpha_0_1_index = names.index('alpha 0.10')\n",
        "clf_alpha_0_1 = classifiers[alpha_0_1_index]\n",
        "clf_alpha_0_1.fit(X_train, y_train)\n",
        "y_pred_alpha_0_1 = clf_alpha_0_1.predict(X_test)\n",
        "cm = confusion_matrix(y_test, y_pred_alpha_0_1)\n",
        "plt.figure(figsize=(8, 6))\n",
        "sns.heatmap(cm, annot=True, fmt='d', cmap='Blues', cbar=False,\n",
        "            xticklabels=['Predicted 0', 'Predicted 1'],\n",
        "            yticklabels=['Actual 0', 'Actual 1'])\n",
        "plt.xlabel('Predicted Label')\n",
        "plt.ylabel('True Label')\n",
        "plt.title('Confusion Matrix for MLP (alpha = 0.1)')\n",
        "plt.show()"
      ],
