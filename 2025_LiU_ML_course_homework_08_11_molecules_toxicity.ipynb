    {
      "cell_type": "markdown",
      "source": [
        "# Varying regularization in multi-layer perceptron\n"
      ],
      "metadata": {
        "id": "Tm2it8Eayx_l"
      }
    },
    {
      "cell_type": "code",
      "source": [
        "alphas = np.logspace(-1, 1, 5)\n",
        "\n",
        "classifiers = []\n",
        "names = []\n",
        "for alpha in alphas:\n",
        "    classifiers.append(\n",
        "        make_pipeline(\n",
        "            StandardScaler(),\n",
        "            MLPClassifier(alpha=alpha, max_iter=1000, random_state=42),\n",
        "        )\n",
        "    )\n",
        "    names.append(f\"alpha {alpha:.2f}\")"
      ],
      "metadata": {
        "id": "nzpPPbr1xOGe"
      },
      "execution_count": 65,
      "outputs": []
    },
    {
      "cell_type": "code",
      "source": [
        "df_metrics_MLP = pd.DataFrame(columns=[\"alpha\", \"accuracy\", \"precision\", \"recall\", \"f1\", \"roc_auc\"])"
      ],
      "metadata": {
        "id": "ZWTpA8WUznhL"
      },
      "execution_count": 66,
      "outputs": []
    },
    {
      "cell_type": "code",
      "source": [
        "for name, clf in zip(names, classifiers):\n",
        "    clf.fit(X_train, y_train)\n",
        "    y_pred = clf.predict(X_test)\n",
        "    accuracy = accuracy_score(y_test, y_pred)\n",
        "    precision = precision_score(y_test, y_pred)\n",
        "    recall = recall_score(y_test, y_pred)\n",
        "    f1 = f1_score(y_test, y_pred)\n",
        "    roc_auc = roc_auc_score(y_test, y_pred)\n",
        "    new_row_df = pd.DataFrame([{\"alpha\": name, \"accuracy\": accuracy, \"precision\": precision, \"recall\": recall, \"f1\": f1, \"roc_auc\": roc_auc}])\n",
        "    df_metrics_MLP = pd.concat([df_metrics_MLP, new_row_df], ignore_index=True)"
      ],
      "metadata": {
        "colab": {
          "base_uri": "https://localhost:8080/"
        },
        "id": "TQmc8gJ2z1d7",
